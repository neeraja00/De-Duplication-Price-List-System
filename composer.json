{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "De-Duplication Price List System",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "*",
        "mongodb/laravel-mongodb": "^4.0|^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/app/",
            "Database\\Factories\\": "backend/database/factories/",
            "Database\\Seeders\\": "backend/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "backend/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
